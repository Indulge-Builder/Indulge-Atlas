# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
**/.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the documented template committable
!.env.example

# vercel
.vercel

# typescript
tsconfig.tsbuildinfo
*.tsbuildinfo
next-env.d.ts

# generated Supabase types — regenerate with `npm run types:generate`
lib/types/database.generated.ts

# data exports and personal assets — never commit these
exports/
*.csv
scripts/chetto-unmapped-report.json
scripts/chetto-suggestions-report.json
scripts/chetto-metadata-cache.json
*.jpeg
*.jpg
*.png
*.plan.md
*.plan copy.md

# Sentry Config File
.env.sentry-build-plugin

.next-local

# Local dev server log
dev.log
