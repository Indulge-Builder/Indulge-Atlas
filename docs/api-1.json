      "post": {
        "tags": [
          "joule",
          "Chat"
        ],
        "summary": "Ask Chetto",
        "description": "Send a message and receive streaming AI-generated insights based on your group conversations. The response is an NDJSON stream (`application/x-ndjson`) where each line is a JSON object.",
        "operationId": "chat_endpoint_v1_insights_chat_post",
        "parameters": [
          {
            "name": "org_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Optional organization ID for access control",
              "title": "Org Id"
            },
            "description": "Optional organization ID for access control"
          },
          {
            "name": "sub_org_ids",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional list of sub-organization IDs for access control",
              "title": "Sub Org Ids"
            },
            "description": "Optional list of sub-organization IDs for access control"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "NDJSON stream. Each line is a JSON object with a `type` discriminator: `message` (progress), `done` (final result), or `error`.",
            "content": {
              "application/json": {
                "schema": {}
              },
              "application/x-ndjson": {
                "schema": {
                  "oneOf": [
                    {
                      "additionalProperties": true,
                      "properties": {
                        "type": {
                          "const": "message",
                          "default": "message",
                          "title": "Type",
                          "type": "string"
                        },
                        "data": {
                          "additionalProperties": true,
                          "title": "Data",
                          "type": "object"
                        }
                      },
                      "required": [
                        "data"
                      ],
                      "title": "ChatStreamMessageLine",
                      "type": "object"
                    },
                    {
                      "$defs": {
                        "ChatDoneData": {
                          "additionalProperties": true,
                          "properties": {
                            "chat_id": {
                              "title": "Chat Id",
                              "type": "string"
                            },
                            "message_id": {
                              "title": "Message Id",
                              "type": "string"
                            },
                            "reply": {
                              "title": "Reply",
                              "type": "string"
                            },
                            "media": {
                              "default": [],
                              "items": {
                                "additionalProperties": true,
                                "type": "object"
                              },
                              "title": "Media",
                              "type": "array"
                            }
                          },
                          "required": [
                            "chat_id",
                            "message_id",
                            "reply"
                          ],
                          "title": "ChatDoneData",
                          "type": "object"
                        }
                      },
                      "additionalProperties": true,
                      "properties": {
                        "type": {
                          "const": "done",
                          "default": "done",
                          "title": "Type",
                          "type": "string"
                        },
                        "data": {
                          "$ref": "#/$defs/ChatDoneData"
                        }
                      },
                      "required": [
                        "data"
                      ],
                      "title": "ChatStreamDoneLine",
                      "type": "object"
                    },
                    {
                      "$defs": {
                        "ChatErrorData": {
                          "additionalProperties": true,
                          "properties": {
                            "status_code": {
                              "title": "Status Code",
                              "type": "integer"
                            },
                            "detail": {
                              "title": "Detail",
                              "type": "string"
                            }
                          },
                          "required": [
                            "status_code",
                            "detail"
                          ],
                          "title": "ChatErrorData",
                          "type": "object"
                        }
                      },
                      "additionalProperties": true,
                      "properties": {
                        "type": {
                          "const": "error",
                          "default": "error",
                          "title": "Type",
                          "type": "string"
                        },
                        "data": {
                          "$ref": "#/$defs/ChatErrorData"
                        }
                      },
                      "required": [
                        "data"
                      ],
                      "title": "ChatStreamErrorLine",
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
