# =============================================================================
# Indulge Atlas — environment template
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# On Vercel, set these in Project Settings → Environment Variables.
# =============================================================================

# ── REQUIRED: app will not boot correctly without these ──────────────────────
# proxy.ts returns a 503 "Server configuration error" if the two NEXT_PUBLIC_
# Supabase vars are missing. getAuthUser() needs the service role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key   # server-only, bypasses RLS

# Public base URL (used by site-url helper / auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Elia AI (Anthropic) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ELIA_ANALYSIS_SECRET=random-long-secret   # Bearer for POST /api/elia/analyse-client

# ── Chetto / Joule (WhatsApp group intel) ────────────────────────────────────
# OpenAPI reference: api-1.json (base https://apiv2.chetto.ai/joule). 60 req/min per endpoint.
CHETTO_API_KEY=your-chetto-api-key
CHETTO_ORG_ID=your-chetto-parent-org-id   # parent org (Indulge Global); sub-orgs resolved via API

# ── Freshdesk (service history) ──────────────────────────────────────────────
FRESHDESK_API_KEY=your-freshdesk-api-key

# ── Gupshup WhatsApp chatbot (separate from Meta WhatsApp) ────────────────────
GUPSHUP_API_KEY=your-gupshup-api-key
GUPSHUP_APP_NAME=your-gupshup-app-name
GUPSHUP_WEBHOOK_SECRET=your-gupshup-webhook-secret
GUPSHUP_ANTHROPIC_API_KEY=sk-ant-...        # optional: dedicated key for the bot
GUPSHUP_PARTNER_NUMBER=+91XXXXXXXXXX        # optional

# ── Meta / lead ad ingestion ─────────────────────────────────────────────────
META_ACCESS_TOKEN=your-meta-access-token
META_AD_ACCOUNT_ID=act_XXXXXXXXXX

# ── Webhooks / internal secrets ──────────────────────────────────────────────
PABBLY_WEBHOOK_SECRET=your-pabbly-webhook-secret
CRON_SECRET=random-long-secret
INTERNAL_API_SECRET=random-long-secret
FINANCE_EMAIL=finance@indulge.global

# ── Upstash rate limiting (webhooks fail-closed / 429 if missing) ────────────
UPSTASH_REDIS_REST_URL=https://YOUR.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Sentry (currently disabled in code — safe to leave unset) ─────────────────
SENTRY_AUTH_TOKEN=your-sentry-auth-token
